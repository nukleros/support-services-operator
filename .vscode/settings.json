{
  // overlays use typed templates (e.g. `replicas: !!int {{ .replicas }}` or `replicas: !!int "%v"`),
  // which are not valid typed values until they are rendered.  register the resolved tag names
  // so the redhat yaml extension does not report them as unresolved.
  "yaml.customTags": [
    "tag:yaml.org,2002:int mapping",
    "tag:yaml.org,2002:int scalar",
    "tag:yaml.org,2002:str mapping"
  ]
}
